# ==============================================================================
# PARKCLOUD COLOMBIA - CONFIGURACIÓN DE ARQUITECTURA HEXAGONAL
# Sprint 1: Entorno Local (PostgreSQL + Disco Local + Cierre Local)
# Sprint 2 (Cloud Migration): Cambiar proveedores a AZURE_* sin tocar el Dominio
# ==============================================================================

PORT=4000

# 1. PUERTO TRANSACCIONAL ACID (PostgreSQL Local -> Azure Database for PostgreSQL Flexible B1ms)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=parkcloud_db
DB_SSL=false

# 2. CONMUTADORES DE ADAPTADORES HEXAGONALES (LOCAL vs AZURE CLOUD)
STORAGE_PROVIDER=LOCAL_DISK          # Valores: LOCAL_DISK | AZURE_BLOB_LRS
LAKE_PROVIDER=LOCAL_PARQUET          # Valores: LOCAL_PARQUET | AZURE_DATALAKE_GEN2
AUTH_PROVIDER=LOCAL_JWT_RBAC         # Valores: LOCAL_JWT_RBAC | MICROSOFT_ENTRA_ID

# 3. GOBIERNO DE DATOS Y LEY ESTATUTARIA 1581 DE 2012
LEY1581_PLATE_SALT=PARKCLOUD_BOGOTA_SALT_2026
EVIDENCE_HOT_DAYS=30
EVIDENCE_COOL_DAYS=90
EVIDENCE_ARCHIVE_PURGE_DAYS=365

# 4. PARÁMETROS FINOPS (ANTEPROYECTO SECCIÓN 5)
FINOPS_MONTHLY_BUDGET_USD=21.32
FINOPS_SCHEDULED_OPTIMIZED_USD=8.50
AZURE_STUDENTS_CREDIT_USD=100.00
